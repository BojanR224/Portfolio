# ──────────────────────────────────────────────────────────────────────
# Portfolio — environment configuration
# Copy to `.env` (Docker Compose reads it automatically):  cp .env.example .env
# For local dev without Docker you don't need this file at all —
# the backend's defaults are already set up for localhost.
# ──────────────────────────────────────────────────────────────────────

# Domain the site is served from. Caddy uses it to provision HTTPS.
# Use your real domain in production; "localhost" gets a local self-signed cert.
DOMAIN=localhost

# Comma-separated list of origins allowed to call the API (CORS).
# In production set this to your site origin, e.g. https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Contact-form rate limit (successful submissions per IP per hour).
CONTACT_RATE_LIMIT=5

# Trust X-Forwarded-For from the reverse proxy (true behind Caddy,
# false for direct local dev). Controls how client IPs are resolved.
TRUST_PROXY_HEADERS=true

# ── SMTP (all optional) ───────────────────────────────────────────────
# Leave SMTP_HOST empty to skip email entirely — submissions are still
# validated, rate-limited and saved to the database; they're just logged
# to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Optional custom From: address (defaults to SMTP_USER or CONTACT_TO_EMAIL)
SMTP_SENDER=
# Where contact-form notifications are sent. Required if SMTP_HOST is set.
CONTACT_TO_EMAIL=