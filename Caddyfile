# Reverse proxy + automatic HTTPS.
# DOMAIN is injected by Docker Compose (see .env). With a real domain,
# Caddy obtains and renews Let's Encrypt certificates automatically.
{$DOMAIN} {
    encode zstd gzip

    # API (including /api/docs) → FastAPI
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Everything else → the built SPA served by nginx
    handle {
        reverse_proxy frontend:8081
    }
}